# ANDREWS-CURTIS-CHALLENGE
# Exclusion patterns for local development and system-generated artifacts

# System files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store

# Environment and workspace configuration
.vscode/
.idea/
*.swp
*.swo
*~

# Python artifacts
__pycache__/
*.py[cod]
*.class
.pytest_cache/
.venv/
venv/

# Temporary and log files
*.tmp
*.log
*.bak
*.sav
*.old

# Search output and solution bundles, which are large and reproducible
runs/
solutions/*.json
!solutions/example.json

# Documentation and archive artifacts
README.md.bak
*.zip
*.tar.gz
*.rar
*.7z

# Local campaign tooling, not published while the competition runs.
src/search/engine.py
src/search/campaign.py
src/harness/submit.py
src/harness/launch_watch.py
tests/test_engine.py
